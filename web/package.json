{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:scan": "node scripts/architecture-scan.mjs",
    "architecture:scan:strict": "node scripts/architecture-scan.mjs --strict",
